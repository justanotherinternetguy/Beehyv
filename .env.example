# Beehyv environment variables.
#
# Copy this file to `.env` and fill in your values. `run.py` loads `.env`
# automatically via python-dotenv at startup.

# ── OpenRouter (cloud inference) ──────────────────────────────────────────────

# Required for `discuss`, `brainstorm`, `research`, and `codegen` (cloud path).
OPENROUTER_API_KEY=

# Default model for any agent role that does not have a per-role override
# below. Verified present in the OpenRouter catalog on 2026-05-03.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Per-role model overrides (recommended) ────────────────────────────────────
#
# Reward-hacking guard: the judge MUST be a different model from the planner.
# Same-model judging causes the judge to validate the planner/coder's spurious
# correlations (Pan et al. 2024, "Spontaneous Reward Hacking in Iterative
# Self-Refinement"; audit §7 row 2). Pick two distinct families.

# Strong reasoning model — drives planning and per-paper agent proposals.
OPENROUTER_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Code-tuned model — drives coding and debugging agents.
OPENROUTER_CODER_MODEL=tencent/hy3-preview:free

# Judge model — MUST differ from OPENROUTER_PLANNER_MODEL.
OPENROUTER_JUDGE_MODEL=google/gemma-4-31b-it:free

# ── OpenAI (fallback path used by paper2code) ─────────────────────────────────

OPENAI_API_KEY=

# ── Optional: route inference to a local server via vLLM/Ollama ──────────────

# LLM_BACKEND=gx10
# LOCAL_LLM_URL=http://100.123.34.54:11434
# LOCAL_LLM_MODEL=gemma4:31b
# LOCAL_LLM_MAX_TOKENS=2048
# LOCAL_LLM_TIMEOUT=300

# ── Optional: GX10 remote training host (tools/run_remote_problem.sh) ────────
#
# Authentication is via SSH keys only. Run `ssh-copy-id` once to the host;
# do NOT use password authentication.

# ASUS_GX10_HOST=asus@100.123.34.54
# ASUS_GX10_PORT=22
# ASUS_GX10_REMOTE_DIR=/home/asus/Beehyv_remote/<problem-name>
# ASUS_GX10_PYTHON=/home/asus/Beehyv_remote/venv/bin/python
# ASUS_GX10_SSH_CONFIG=/dev/null

# ── Optional: ingestion (Grobid) ──────────────────────────────────────────────

# GROBID_DIR=$HOME/grobid-0.7.3
